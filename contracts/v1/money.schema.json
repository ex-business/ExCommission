{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:excommission:v1:money",
  "type": "object",
  "properties": {
    "currency": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "minor_units": {
      "type": "string",
      "pattern": "^[0-9]+$"
    }
  },
  "required": [
    "currency",
    "minor_units"
  ],
  "additionalProperties": false
}
