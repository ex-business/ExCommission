{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:excommission:v1:plan",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "standard_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "route": {
      "type": "object",
      "properties": {
        "product_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "event_type": {
          "type": "string",
          "enum": [
            "FEE_CONFIRMED",
            "TRADE_CLOSED",
            "ORDER_CONFIRMED"
          ]
        },
        "scene": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "product_code",
        "event_type",
        "scene"
      ],
      "additionalProperties": false
    },
    "currency": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "calendar_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "agent_policy": {
      "type": "object",
      "properties": {
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 3
        },
        "self_reward": {
          "const": false
        },
        "earn_while_frozen": {
          "type": "boolean"
        },
        "require_contract": {
          "type": "boolean"
        },
        "grade_window": {
          "type": "string",
          "enum": [
            "PREVIOUS_CALENDAR_MONTH",
            "BUSINESS_DAY"
          ]
        },
        "grade_evaluation": {
          "type": "string",
          "enum": [
            "DAILY"
          ]
        },
        "eligibility_required": {
          "const": true
        },
        "day_end": {
          "type": "object",
          "properties": {
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "source_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "qualification_policy_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "member_depths": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "volume_depths": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "timezone",
            "source_id",
            "qualification_policy_id",
            "member_depths",
            "volume_depths"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "max_depth",
        "self_reward",
        "earn_while_frozen",
        "require_contract",
        "grade_window",
        "grade_evaluation",
        "eligibility_required"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "grade_window": {
                "const": "BUSINESS_DAY"
              }
            }
          },
          "then": {
            "required": [
              "day_end"
            ],
            "properties": {
              "max_depth": {
                "const": 3
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "day_end"
              ]
            }
          }
        }
      ]
    },
    "grade_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "rank": {
            "type": "integer",
            "minimum": 0
