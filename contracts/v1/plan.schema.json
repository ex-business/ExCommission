          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "metric": {
                  "type": "string",
                  "enum": [
                    "PERSONAL_NET_BASIS",
                    "TEAM_NET_BASIS",
                    "ACTIVE_DIRECT_COUNT",
                    "EFFECTIVE_MEMBER_COUNT",
                    "TEAM_VALID_VOLUME"
                  ]
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "EQ",
                    "NE",
                    "GT",
                    "GTE",
                    "LT",
                    "LTE"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^[0-9]{1,18}(\\.[0-9]{1,8})?$"
                },
                "unit": {
