MYSQL_ROOT_PASSWORD=请替换为本地随机密码
MYSQL_PASSWORD=请替换为另一组本地随机密码
MYSQL_PORT=13316
LOCAL_OPERATOR_TOKEN=请运行初始化工具生成
LOCAL_APPROVER_TOKEN=请运行初始化工具生成
LOCAL_CURSOR_KEY=请运行初始化工具生成
LOCAL_SOURCE_KEY=请运行初始化工具生成
LOCAL_PAYMENT_KEY=replace-with-local-random-key

# 注册接入默认关闭；URL 指向后续真实会员注册页，未配置时只返回邀请码。
LOCAL_REGISTRATION_ENABLED=false
LOCAL_REGISTRATION_KEY=请运行初始化工具生成独立注册签名密钥
LOCAL_REGISTRATION_URL=

# 独立有效会员模块默认关闭，不改变既有计佣或注册行为。
LOCAL_QUALIFICATION_ENABLED=false
LOCAL_QUALIFICATION_KEY=请运行初始化工具生成独立达标来源签名密钥

# 日终业务量定级扩展；API 与 worker 同时开启，旧月度方案行为不变。
LOCAL_DAYEND_ENABLED=false
